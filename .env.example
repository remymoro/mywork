# Copier ce fichier en .env.local et remplir les valeurs (ne jamais commiter .env.local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Facultatif : plafond de stockage affiché par la jauge du Drive, en octets (défaut : 1 Go, offre gratuite Supabase).
# STORAGE_LIMIT_BYTES=1073741824

# Facultatif : envoi d'e-mails par Resend (rendez-vous). Sans clé, les e-mails sont seulement écrits dans les journaux.
# RESEND_API_KEY=
# RESEND_FROM=MyWork <rdv@mywork.website>

# Visio des rendez-vous (LiveKit Cloud) : serveur uniquement, jamais NEXT_PUBLIC_.
# LIVEKIT_URL=wss://<projet>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
